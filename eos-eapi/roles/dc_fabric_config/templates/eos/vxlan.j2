{% if 'leaf'in group_names %}
!
interface Vxlan1
   description {{ inventory_hostname }}_VTEP
   vxlan source-interface Loopback1
   vxlan udp-port 4789
   vxlan learn-restrict any
{% for vlan in vlans %}
   vxlan vlan {{ vlan.id }} vni 100{{ vlan.id }}
{% endfor %}
!
ip virtual-router mac-address {{ ip_virtual_router_mac_address }}
{% endif %}