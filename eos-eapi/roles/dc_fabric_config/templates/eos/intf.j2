!
interface loopback0
 description RouterID
 ip address {{ router_id }}/32
!
interface loopback1
 description VTEP
 ip address {{ vtep }}/32
!
{% for ethernet_interface in ethernet_interfaces %}
interface {{ethernet_interface.name}}
 no switchport
 description {{ethernet_interface.peer}}_{{ethernet_interface.peer_interface}}
 ip address {{ethernet_interface.ip_address}}
{% if ethernet_interface.shutdown == 'true' %}
 shutdown
{% else %}
 no shutdown
!
{% endif %}
{% endfor %}